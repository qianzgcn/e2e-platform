generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum TestCaseStatus {
  not_run
  queued
  generating
  running
  success
  failed
}

enum RunLogStatus {
  queued
  generating
  running
  success
  failed
}

model Project {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  baseUrl    String
  repoUrl    String?
  promptHint String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  variables  ProjectVariable[]
  groups     TestCaseGroup[]
  testCases  TestCase[]
  generations TestCaseGeneration[]
  candidates  TestCaseCandidate[]
}

model ProjectVariable {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  value     String   @db.Text
  description String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
}

model TestCaseGroup {
  id        Int        @id @default(autoincrement())
  projectId Int
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  testCases TestCase[]

  @@unique([projectId, name])
  @@index([projectId])
}

model TestCase {
  id                String         @id
  title             String
  groupId           Int
  group             TestCaseGroup  @relation(fields: [groupId], references: [id])
  projectId         Int
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  naturalLanguage   String         @db.Text
  playwrightScript  String?        @db.LongText
  scriptNeedsGeneration Boolean    @default(true)
  status            TestCaseStatus @default(not_run)
  lastFailureReason String?        @db.Text
  lastRunAt         DateTime?
  scriptGeneratedAt DateTime?
  createdAt         DateTime       @default(now())
  editedAt          DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  runLogs           RunLog[]

  @@index([groupId])
  @@index([projectId])
}

model RunLog {
  id            Int          @id @default(autoincrement())
  testCaseId    String
  testCase      TestCase     @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  status        RunLogStatus
  failureReason String?      @db.Text
  stdout        String?      @db.LongText
  stderr        String?      @db.LongText
  startedAt     DateTime     @default(now())
  finishedAt    DateTime?

  @@index([testCaseId])
}

enum CandidateStatus {
  pending
  imported
}

model TestCaseGeneration {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logs      String   @db.Text
  hint      String?  @db.Text
  candidates TestCaseCandidate[]
  createdAt DateTime @default(now())

  @@index([projectId])
}

model TestCaseCandidate {
  id              Int              @id @default(autoincrement())
  projectId       Int
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generationId    Int
  generation      TestCaseGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  title           String
  groupName       String
  naturalLanguage String           @db.Text
  status          CandidateStatus  @default(pending)
  createdAt       DateTime         @default(now())

  @@index([projectId])
  @@index([generationId])
}
